XAI_API_KEY=
XAI_MODEL=grok-3-mini
BRIEF_USER_ID=default
BRIEF_OWNER_NAME=          # Donna greets you by this name if set
BRIEF_MORNING_HOUR=6       # brief-web auto-runs once a day at/after this local hour

# To use an OpenAI-compatible gateway instead of api.x.ai (e.g. aimlapi.com):
#   XAI_API_BASE=https://api.aimlapi.com/v1
#   XAI_MODEL=x-ai/grok-3-mini-beta
XAI_API_BASE=

# Google OAuth (Gmail + Calendar, read-only). Defaults shown; override if needed.
GOOGLE_CLIENT_SECRETS=credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json
